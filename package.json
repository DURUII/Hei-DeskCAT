{
  "name": "desktripper",
  "version": "0.9.0",
  "description": "A desktop companion that responds to screenshots and provides travel companionship",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "build": "electron-builder",
    "build:win": "node scripts/build.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeskTripper/DeskTripper.git"
  },
  "keywords": [
    "electron",
    "travel",
    "screenshot",
    "companion",
    "desktop"
  ],
  "author": "DeskTripper Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DeskTripper/DeskTripper/issues"
  },
  "homepage": "https://github.com/DeskTripper/DeskTripper#readme",
  "devDependencies": {
    "electron": "^21.0.0",
    "electron-builder": "^23.0.0"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "electron-screenshots": "^0.5.27",
    "electron-store": "^8.1.0",
    "openai": "^4.0.0"
  },
  "build": {
    "appId": "com.desktripper.app",
    "productName": "DeskTripper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "*.html",
      "*.js",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeskTripper"
    }
  }
}